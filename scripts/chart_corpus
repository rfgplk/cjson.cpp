#!/usr/bin/env python3
"""Turn corpus_vs / corpus_bench output into charts.

    scripts/vsbuild benches/corpus_vs.cpp
    taskset -c 0 ./bin/corpus_vs > benches/results/corpus_vs.txt
    scripts/chart_corpus benches/results/corpus_vs.txt              # one per segment
    scripts/chart_corpus benches/results/corpus_vs.txt --headline    # the hero figure

Two outputs:

  * per-segment grouped bars — a "segment" is an op group (parse/index, parse/tree,
    extract-lazy, extract-dom/index, extract-dom/tree, serialize/index,
    serialize/tree), corpora along x, one bar per library. `--by corpus`
    flips it: one figure per corpus, ops along x.
  * `--headline` — one PNG, three panels side by side (GB/s, cyc/op, ins/op) for a
    single corpus (default github_events). This is the figure for a README.

INDEX vs TREE — the bands never share a figure. cjson, simdjson-dom and yyjson build a
flat index over the caller's bytes and defer string materialization and key lookup;
glz::generic, rapidjson, boost.json and nlohmann build an owning mutable node tree, which
costs several times the instructions no matter how fast the parser driving it is. Those
are different products, not different speeds, and a single ranked bar chart over both
asserts an ordering the numbers do not support. corpus_vs prints them as separate op
groups so they land in separate figures here; `--headline-op` defaults to the index band.

`--mode github` renders on GitHub's Primer dark canvas (#0d1117) instead of this
project's own dark surface, so a PNG served to README.md under
`prefers-color-scheme: dark` sits flush with the page. Output lands in benches/charts/.

Palette, surfaces and the figure engine live in scripts/_chartlib.py, shared with
scripts/chart_vs so the two tools cannot drift apart in style.

Two warnings the numbers will not give you:

  * GB/s divides by the WHOLE document on parse and extract-dom, by the EMITTED bytes
    on serialize, and on extract-lazy by the bytes each contender actually reads —
    glaze's walk stops at the pointer, cjson and simdjson index the whole buffer. That
    last segment is therefore a SCAN RATE, and it ranks the opposite way from cyc/op,
    which is the column that answers who resolves the query first. Both are true.
  * cyc/op spans orders of magnitude between a 65 KB and a 26 MB corpus, so it is
    drawn on a log axis whenever the spread demands one. Check the axis before
    eyeballing a ratio.
"""

import argparse
import os
import sys
from collections import OrderedDict

# the script has no .py extension and may be reached through a symlink, so put its own
# real directory on the path rather than trusting sys.path[0]
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from _chartlib import METRICS, MODES, draw, draw_headline, parse      # noqa: E402


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", nargs="?", default="-",
                    help="corpus_vs/corpus_bench output file, or - for stdin")
    ap.add_argument("--by", choices=("op", "corpus"), default="op",
                    help="one figure per op group (default) or per corpus")
    ap.add_argument("--metric", choices=list(METRICS), default="gbps",
                    help="which column to plot (default gbps)")
    ap.add_argument("--all-metrics", action="store_true",
                    help="emit a figure per segment for every metric")
    ap.add_argument("--headline", nargs="?", const="github_events", default=None,
                    metavar="CORPUS",
                    help="the hero figure: GB/s + cyc/op + ins/op side by side for one "
                         "corpus (default github_events)")
    ap.add_argument("--headline-op", default="parse/index",
                    help="op for --headline (default parse/index — the tape band; "
                         "parse/tree is the owning-node-tree band and the two do not "
                         "belong on one figure)")
    ap.add_argument("--mode", choices=MODES, default="light",
                    help="surface the figure is drawn for (github = Primer dark canvas)")
    ap.add_argument("--out", default="benches/charts", help="output directory")
    args = ap.parse_args()

    text = sys.stdin.read() if args.input == "-" else open(args.input).read()
    rows = parse(text)
    if not rows:
        sys.exit("chart_corpus: no benchmark rows found — is that corpus_vs output?")

    os.makedirs(args.out, exist_ok=True)

    if args.headline:
        path = draw_headline(rows, args.headline, args.headline_op, args.out, args.mode)
        if not path:
            have = sorted({r["corpus"] for r in rows if r["op"] == args.headline_op})
            sys.exit(f"chart_corpus: no '{args.headline_op}' rows for "
                     f"'{args.headline}'. present: {', '.join(have) or '(none)'}")
        print(path)
        print(f"chart_corpus: 1 figure in {args.out}/")
        return

    if args.by == "op":
        groups, key, series = OrderedDict(), "corpus", "impl"
        for r in rows:
            groups.setdefault(r["op"], []).append(r)
        note = ("GB/s divides by the whole document, except serialize (emitted bytes) and "
                "extract-lazy (bytes each contender actually reads — a scan rate, not a race).")
    else:
        groups, key, series = OrderedDict(), "op", "impl"
        for r in rows:
            groups.setdefault(r["corpus"], []).append(r)
        note = ""

    metrics = list(METRICS) if args.all_metrics else [args.metric]
    written = []
    for m in metrics:
        if m == "gbps" and all(r["gbps"] != r["gbps"] for r in rows):
            print("chart_corpus: input has no GB/s column (pre-8-field layout), skipping")
            continue
        written += draw(groups, key, series, m, args.out, f"{args.by}-", args.mode, note)

    for p in written:
        print(p)
    print(f"chart_corpus: {len(written)} figure(s) in {args.out}/")


if __name__ == "__main__":
    main()
